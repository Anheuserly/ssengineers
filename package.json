{
  "name": "ssengineers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "next:build": "next build --webpack",
    "build": "npm run next:build && opennextjs-cloudflare build --skipNextBuild",
    "build:pages": "npm run build && cp .open-next/worker.js .open-next/assets/_worker.js",
    "build:cf:pages": "npm run build:pages",
    "pages:build": "npm run build:pages",
    "postinstall": "node ./scripts/cloudflare-shim.js",
    "start": "next start",
    "lint": "eslint",
    "sync:project-images": "node scripts/import-mediafire-project-images.mjs --clean true",
    "sync:brand-logos": "node scripts/sync-brand-logos.mjs",
    "sync:client-logos": "node scripts/sync-client-logos.mjs",
    "sync:logos": "npm run sync:brand-logos && npm run sync:client-logos"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.1.6",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5",
    "wrangler": "^4.132.0"
  },
  "overrides": {
    "esbuild": "^0.25.4"
  }
}
